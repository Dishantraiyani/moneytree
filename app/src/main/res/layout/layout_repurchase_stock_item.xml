<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_2sdp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:id="@+id/cl_product_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_5sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_repurchase_no"
                style="@style/LoginSubFontsZeroWrap"
                android:layout_weight="1"
                android:fontFamily="@font/inter_semi_bold"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:textColor="@color/orange"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold"
                app:guidelineUseRtl="true"
                app:layout_constraintEnd_toStartOf="@id/iv_next"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Product Name" />

            <ImageView
                android:id="@+id/iv_next"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/_5sdp"
                android:contentDescription="@string/next"
                android:src="@drawable/arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_repurchase_no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_repurchase_no" />

        </LinearLayout>

        <View
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_repurchase_no" />

        <LinearLayout
            android:id="@+id/ll_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_line">

            <TextView
                android:id="@+id/tv_stock_id_title"
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/stockiest_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_stock_id"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/stockiest_title" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_stock_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_stock">

            <TextView
                android:id="@+id/tv_stock_type_title"
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/stockiest_type_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_stock_type"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/stockiest_type_title" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_member_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_stock_type">

            <TextView
                android:id="@+id/tv_member_id_title"
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/member_id_title_"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_member_id"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/member_id_title_" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_member_id">

            <TextView
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/date_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_date"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/date_title" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_date">

            <TextView
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/remark"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_remark"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/remark" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_remark">

            <TextView
                android:id="@+id/tv_total_title"
                style="@style/LoginSubFontsWrap"
                android:fontFamily="@font/inter_medium"
                android:gravity="start"
                android:lines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_5sdp"
                android:text="@string/total_"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line" />

            <TextView
                android:id="@+id/tv_total"
                style="@style/LoginSubFontsWrap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter_medium"
                android:gravity="end"
                android:lines="1"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/orange"
                android:textSize="@dimen/_10sdp"
                app:guidelineUseRtl="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_line"
                tools:text="@string/total_" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_payment_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:background="@drawable/bg_payment_summary"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_total">

            <LinearLayout
                android:id="@+id/ll_payment_summary_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
				android:paddingTop="@dimen/_8sdp"
				android:paddingBottom="0dp">

                <TextView
                    android:id="@+id/tv_payment_summary_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semi_bold"
                    android:text="@string/payment_summary"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/iv_payment_summary_arrow"
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:contentDescription="@string/payment_summary"
                    android:src="@drawable/ic_arrow_expand_collapse" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_payment_summary_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
				android:layout_marginTop="@dimen/_8sdp">

                <!-- Payment Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_payment_mode_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/payment_mode_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_payment_mode"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/orange"
                        android:textSize="@dimen/_9sdp"
                        tools:text="Wallet" />
                </LinearLayout>

                <!-- Used From -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_used_from_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/used_from_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_used_from"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_9sdp"
                        tools:text="Member" />
                </LinearLayout>

                <!-- Voucher Amount -->
                <LinearLayout
                    android:id="@+id/ll_voucher_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_voucher_amount_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/voucher_amount_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_voucher_amount"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_9sdp"
                        tools:text="₹50.00" />
                </LinearLayout>

                <!-- Wallet Amount -->
                <LinearLayout
                    android:id="@+id/ll_wallet_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_wallet_amount_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/wallet_amount_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_wallet_amount"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/orange"
                        android:textSize="@dimen/_9sdp"
                        tools:text="₹2000.00" />
                </LinearLayout>

                <!-- OV Credit Amount -->
                <LinearLayout
                    android:id="@+id/ll_ov_credit_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_ov_credit_amount_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/ov_credit_amount_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_ov_credit_amount"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_9sdp"
                        tools:text="₹0.00" />
                </LinearLayout>

                <!-- Cash Amount -->
                <LinearLayout
                    android:id="@+id/ll_cash_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_cash_amount_title"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/cash_amount_title"
                        android:textColor="@color/gray_text"
                        android:textSize="@dimen/_9sdp" />

                    <TextView
                        android:id="@+id/tv_cash_amount"
                        style="@style/LoginSubFontsWrap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:gravity="end"
                        android:textColor="@color/orange"
                        android:textSize="@dimen/_9sdp"
                        tools:text="₹200.00" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
