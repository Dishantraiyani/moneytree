<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/half_top_corners_second"
        android:backgroundTint="@color/background_color"
        android:paddingBottom="@dimen/_25sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:id="@+id/view_handle"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="#D1CFC7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="@dimen/_23sdp"
            android:layout_height="@dimen/_23sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:padding="@dimen/_4sdp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_dark" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:fontFamily="@font/inter_bold"
            android:text="@string/select_filter"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_handle" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constrainedHeight="true"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintBottom_toTopOf="@id/ll_buttons">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_20sdp"
                android:paddingBottom="@dimen/_10sdp">

                <!-- Category Section -->
                <LinearLayout
                    android:id="@+id/ll_category_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_10sdp">

                    <TextView
                        android:id="@+id/tv_categories_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/categories"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/inter_semi_bold" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/card_categories_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@drawable/white_corners_20"
                        android:backgroundTint="@color/white">

                        <ImageView
                            android:id="@+id/iv_categories_type"
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_filter"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/orange" />

                        <TextView
                            android:id="@+id/categories_type_spinner"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textSize="@dimen/_12sdp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_dark"
                            android:fontFamily="@font/inter_medium"
                            app:layout_constraintStart_toEndOf="@id/iv_categories_type"
                            app:layout_constraintEnd_toStartOf="@id/iv_cat_arrow"
                            tools:text="All"/>

                        <ImageView
                            android:id="@+id/iv_cat_arrow"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_spinner_drop_down"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/icon_gray" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <!-- Diseases Section -->
                <LinearLayout
                    android:id="@+id/ll_diseases_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_15sdp">

                    <TextView
                        android:id="@+id/tv_diseases_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/diseases"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/inter_semi_bold" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/card_diseases_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@drawable/white_corners_20"
                        android:backgroundTint="@color/white">

                        <ImageView
                            android:id="@+id/iv_diseases_type"
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_filter"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/orange" />

                        <TextView
                            android:id="@+id/diseases_type_spinner"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textSize="@dimen/_12sdp"
                            android:gravity="center_vertical"
                            android:textColor="@color/text_dark"
                            android:fontFamily="@font/inter_medium"
                            app:layout_constraintStart_toEndOf="@id/iv_diseases_type"
                            app:layout_constraintEnd_toStartOf="@id/iv_dis_arrow"
                            tools:text="All"/>

                        <ImageView
                            android:id="@+id/iv_dis_arrow"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_spinner_drop_down"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/icon_gray" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <!-- Stock Section -->
                <LinearLayout
                    android:id="@+id/ll_stock_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/_15sdp">

                    <TextView
                        android:id="@+id/tv_stock_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stock_status"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/_10sdp"
                        android:fontFamily="@font/inter_semi_bold" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_filter_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@drawable/white_corners_20"
                        android:backgroundTint="@color/white">

                        <ImageView
                            android:id="@+id/iv_status_type"
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:src="@drawable/ic_filter"
                            android:layout_marginStart="@dimen/_12sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/orange" />

                        <Spinner
                            android:id="@+id/status_type_spinner"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:background="@null"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/iv_status_type"
                            app:layout_constraintEnd_toStartOf="@id/iv_stock_arrow"/>

                        <ImageView
                            android:id="@+id/iv_stock_arrow"
                            android:layout_width="@dimen/_20sdp"
                            android:layout_height="@dimen/_20sdp"
                            android:src="@drawable/ic_spinner_drop_down"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:tint="@color/icon_gray" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/ll_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_15sdp"
            android:layout_marginHorizontal="@dimen/_20sdp"
            app:layout_constraintTop_toBottomOf="@id/nsv_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tv_clear"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_10sdp"
                android:background="@drawable/orange_border_five"
                android:text="@string/clear"
                android:textColor="@color/orange"
                android:textAllCaps="true"
                android:textSize="@dimen/_11sdp"
                android:fontFamily="@font/inter_semi_bold"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/tv_apply"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_weight="1.2"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/login_button_border"
                android:text="@string/apply"
                android:textColor="@color/white"
                android:textAllCaps="true"
                android:textSize="@dimen/_11sdp"
                android:fontFamily="@font/inter_semi_bold"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
