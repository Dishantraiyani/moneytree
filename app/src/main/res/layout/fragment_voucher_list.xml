<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:background="@drawable/half_top_corners"
	android:orientation="vertical">

	<include android:id="@+id/layout_header"
		layout="@layout/layout_header"/>

	<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
		android:id="@+id/srl_refresh"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_below="@id/layout_header">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/rv_downline_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingVertical="@dimen/_5sdp"
			android:clipToPadding="false"/>

	</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/cl_voucher_not_found"
		style="@style/LayoutWidthHeightZero"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_below="@+id/layout_header"
		android:visibility="gone">

		<TextView
			android:id="@+id/tv_voucher_not_found"
			style="@style/LayoutWidthHeightZero"
			android:paddingVertical="@dimen/_6sdp"
			android:clipToPadding="false"
			android:text="@string/no_item"
			android:textColor="@color/black"
			android:gravity="center|bottom"
			android:textSize="@dimen/_18sdp"
			android:textStyle="bold"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintBottom_toTopOf="@+id/tv_voucher_not_found_sub"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"/>

		<TextView
			android:id="@+id/tv_voucher_not_found_sub"
			style="@style/LayoutWidthHeightZero"
			android:clipToPadding="false"
			android:text="@string/no_voucher_list_available"
			android:textColor="@color/gray_text"
			android:gravity="center|top"
			android:textSize="@dimen/_14sdp"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintTop_toBottomOf="@id/tv_voucher_not_found"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintEnd_toEndOf="parent"/>

	</androidx.constraintlayout.widget.ConstraintLayout>

	<ProgressBar
		android:id="@+id/progress"
		style="@style/Widget.AppCompat.ProgressBar"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:progressTint="@color/orange"
		android:visibility="gone"
		android:indeterminate="true"
		android:indeterminateTintMode="src_atop"
		android:indeterminateTint="@color/orange"/>

</RelativeLayout>
