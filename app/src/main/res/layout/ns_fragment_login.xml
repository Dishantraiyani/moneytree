<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingStart="@dimen/_20sdp"
    android:paddingEnd="@dimen/_20sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/_20sdp"
        android:paddingTop="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_logo_leaf"
            android:layout_width="@dimen/_145sdp"
            android:layout_height="@dimen/_52sdp"
            android:contentDescription="@null"
            android:src="@drawable/ic_app_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:fontFamily="@font/inter_black"
            android:includeFontPadding="false"
            android:text="@string/login_title"
            android:textColor="@color/green_mid"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logo_leaf" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="false"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_login_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/user_name_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/_51sdp"
            android:layout_marginTop="@dimen/_27sdp"
            android:background="@drawable/bg_input_active"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_13sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_login_subtitle">

            <ImageView
                android:id="@+id/iv_user_icon"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_user_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_10sdp"
                android:autofillHints="username"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_medium"
                android:hint="@string/user_name_hint"
                android:imeOptions="actionNext"
                android:includeFontPadding="false"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:textSize="@dimen/_13sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_user_icon"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/password_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/_49sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:background="@drawable/bg_input_normal"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_11sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_name_container">

            <ImageView
                android:id="@+id/iv_lock_icon"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_login"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/_11sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:autofillHints="password"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_medium"
                android:hint="@string/password_hint"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:textSize="@dimen/_13sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_toggle_password"
                app:layout_constraintStart_toEndOf="@id/iv_lock_icon"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btn_toggle_password"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/show_password"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_eye"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <CheckBox
            android:id="@+id/cb_remember_password"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_31sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:button="@drawable/selector_checkbox"
            android:fontFamily="@font/inter_medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:paddingStart="@dimen/_7sdp"
            android:paddingEnd="0dp"
            android:text="@string/remember_password"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/password_container" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="@dimen/_49sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:background="@drawable/bg_button_login"
            android:elevation="@dimen/_9sdp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="@string/sign_in"
            android:textColor="@color/white"
            android:textSize="@dimen/_13sdp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cb_remember_password" />

        <TextView
            android:id="@+id/tv_signup"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_34sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/signup_text"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_login" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
