<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_repurchase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_6sdp"
    app:cardElevation="@dimen/_2sdp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_repurchase_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_10sdp">

        <!-- Payout No: 23 -->
        <TextView
            android:id="@+id/tv_order_no_repurchase"
            style="@style/LoginSubFontsZeroWrap"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="start"
            android:lines="1"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_10sdp"
            app:guidelineUseRtl="true"
            app:layout_constraintEnd_toStartOf="@id/tv_transaction_type"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Payout No: 23" />

        <!-- Status Pill ("Pending" / "Paid" / "Rejected") -->
        <TextView
            android:id="@+id/tv_transaction_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_soft_circle"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:textColor="#FFA500"
            android:textSize="@dimen/_9sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_order_no_repurchase"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_order_no_repurchase"
            tools:text="Pending" />

        <!-- Payout Name (Direct Retail Offer) -->
        <TextView
            android:id="@+id/tv_payout_name"
            style="@style/LoginSubFontsZeroWrap"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="start"
            android:lines="1"
            android:textColor="@color/black"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold"
            app:guidelineUseRtl="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_order_no_repurchase"
            tools:text="Direct Retail Offer" />

        <!-- Entry Date & Payout Release Date Row -->
        <LinearLayout
            android:id="@+id/ll_dates_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_payout_name">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_entry_date_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/entry_date_title"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_date"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    tools:text="2026-09-30" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_release_date_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/payout_release_date"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_release_date"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10sdp"
                    tools:text="2026-10-05" />
            </LinearLayout>
        </LinearLayout>

        <!-- Payout Amount Card Container -->
        <LinearLayout
            android:id="@+id/ll_payout_amount_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/bg_credit_payout"
            android:backgroundTint="#F5FAF6"
            android:orientation="vertical"
            android:padding="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_dates_row">

            <TextView
                android:id="@+id/tv_total_title"
                style="@style/LoginSubFontsWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/payout_amount"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp" />

            <TextView
                android:id="@+id/tv_total"
                style="@style/LoginSubFontsWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="#0FCE6E"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                tools:text="₹230.10" />
        </LinearLayout>

        <!-- Bottom Card Container (Admin Charge, Net Amount, Coin Amount) -->
        <LinearLayout
            android:id="@+id/ll_bottom_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/bg_credit_payout"
            android:backgroundTint="#FDFBF7"
            android:orientation="horizontal"
            android:padding="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_payout_amount_card">

            <!-- Admin Charge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_charge_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/admin_charge"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_admin_charge"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    tools:text="₹23.01" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@color/line_color" />

            <!-- Net Amount -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_net_amount_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/net_amount"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_net_amount"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    tools:text="₹207.09" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@color/line_color" />

            <!-- Coin Amount -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_coin_amount_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/ov_coin"
                    android:textAllCaps="true"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp" />

                <TextView
                    android:id="@+id/tv_coin_amount"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sdp"
                    tools:text="₹46.02" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
