<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_10sdp"
    android:paddingVertical="@dimen/_5sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_voucher_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_card"
        android:padding="@dimen/_10sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header: Voucher ID (Left) & Status Badge (Right) -->
        <TextView
            android:id="@+id/tv_voucher_id_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/voucher_id_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_voucher_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/downline_total_text"
            android:textSize="@dimen/_13sdp"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_voucher_id_title" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_activated"
            android:fontFamily="@font/inter_semi_bold"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:textColor="@color/status_activated_text"
            android:textSize="@dimen/_8sdp"
            tools:text="Active"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Row 1: Date & Voucher Code -->
        <View
            android:id="@+id/v_divider_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_divider"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_voucher_id" />

        <TextView
            android:id="@+id/tv_date_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/date_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/v_divider_top" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="25-08-2026 09:12 PM"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/tv_date_title" />

        <View
            android:id="@+id/v_vertical_divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/card_divider"
            android:layout_marginHorizontal="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_date_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_date" />

        <TextView
            android:id="@+id/tv_voucher_code_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/voucher_code_"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_divider_top" />

        <TextView
            android:id="@+id/tv_voucher_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_8sdp"
            tools:text="7477900634"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_voucher_code_title" />

        <!-- Row 2: Sponsor ID & Activated By -->
        <View
            android:id="@+id/v_divider_row1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_divider"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_date" />

        <TextView
            android:id="@+id/tv_sponsor_id_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/sponsor_id_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/v_divider_row1" />

        <TextView
            android:id="@+id/tv_sponsor_id"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="2494570150"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/tv_sponsor_id_title" />

        <TextView
            android:id="@+id/tv_activated_by_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/activated_by_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_divider_row1" />

        <TextView
            android:id="@+id/tv_activated_by"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_8sdp"
            tools:text="2003218536"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_activated_by_title" />

        <!-- Row 3: Activated By Name & Entry Date -->
        <View
            android:id="@+id/v_divider_row2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_divider"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sponsor_id" />

        <TextView
            android:id="@+id/tv_activated_by_name_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/activated_by_name_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/v_divider_row2" />

        <TextView
            android:id="@+id/tv_activated_by_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="M/S H kumar harbal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/tv_activated_by_name_title" />

        <TextView
            android:id="@+id/tv_entry_date_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/entry_date_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_divider_row2" />

        <TextView
            android:id="@+id/tv_entry_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginStart="@dimen/_8sdp"
            tools:text="25-08-2026"
            app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_entry_date_title" />

        <!-- Row 4: Expiry Date -->
        <View
            android:id="@+id/v_divider_row3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_divider"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_activated_by_name" />

        <TextView
            android:id="@+id/tv_expiry_date_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:text="@string/expiry_date_title"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_6sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/v_divider_row3" />

        <TextView
            android:id="@+id/tv_expiry_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/dark_black"
            android:textSize="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_2sdp"
            tools:text="12-04-2027"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
            app:layout_constraintTop_toBottomOf="@id/tv_expiry_date_title" />

        <LinearLayout
            android:id="@+id/ll_check_voucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/orange_button_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_expiry_date_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_expiry_date">

            <TextView
                android:id="@+id/tv_check_voucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_2sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:textColor="@color/status_activated_text"
                android:textSize="@dimen/_8sdp"
                android:text="@string/check_voucher" />

            <ImageView
                android:layout_width="@dimen/_7sdp"
                android:layout_height="@dimen/_7sdp"
                android:src="@drawable/arrow_right"
                android:tint="@color/status_activated_text"
                tools:ignore="UseAppTint"
                android:layout_marginEnd="@dimen/_5sdp"/>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
