<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_repurchase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_4sdp"
    app:cardElevation="@dimen/_2sdp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_repurchase_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_8sdp"
        android:paddingVertical="@dimen/_8sdp">

        <!-- Payout No -->
        <TextView
            android:id="@+id/tv_order_no_repurchase"
            style="@style/LoginSubFontsZeroWrap"
            android:fontFamily="@font/inter_semi_bold"
            android:gravity="start"
            android:lines="1"
            android:textColor="@color/orange"
            android:textSize="@dimen/_11sdp"
            android:textStyle="bold"
            app:guidelineUseRtl="true"
            app:layout_constraintEnd_toStartOf="@id/tv_transaction_type"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Payout No: 2" />

        <!-- Status Pill ("Rejected" / "Paid" / "Pending") -->
        <TextView
            android:id="@+id/tv_transaction_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_soft_circle"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:textColor="@color/orange"
            android:textSize="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="@id/tv_order_no_repurchase"
            app:layout_constraintEnd_toStartOf="@id/iv_next"
            app:layout_constraintTop_toTopOf="@id/tv_order_no_repurchase"
            tools:text="Rejected" />

        <!-- Arrow Next -->
        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:alpha="0.8"
            android:contentDescription="@string/next"
            android:src="@drawable/arrow_right"
            app:layout_constraintBottom_toBottomOf="@id/tv_order_no_repurchase"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_order_no_repurchase" />

        <!-- Date -->
        <TextView
            android:id="@+id/tv_date"
            style="@style/LoginSubFontsZeroWrap"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/inter_regular"
            android:gravity="start"
            android:lines="1"
            android:textColor="@color/gray_text"
            android:textSize="@dimen/_9sdp"
            app:guidelineUseRtl="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_order_no_repurchase"
            tools:text="Date: 2026-09-23 00:31:36" />

        <!-- Amount Section -->
        <LinearLayout
            android:id="@+id/ll_total"
            style="@style/LoginSubFontsZeroWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_date">

            <TextView
                android:id="@+id/tv_total_title"
                style="@style/LoginSubFontsWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/amount_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_9sdp" />

            <TextView
                android:id="@+id/tv_total"
                style="@style/LoginSubFontsWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/orange"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                tools:text="₹3700.00" />
        </LinearLayout>

        <!-- Bank Details / Payment Summary Container -->
        <LinearLayout
            android:id="@+id/ll_payment_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:background="@drawable/bg_payment_summary"
            android:orientation="vertical"
            android:padding="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_total">

            <!-- Bank Holder Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bank_holder_name_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/bank_holder_name"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_bank_holder_name"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_9sdp"
                    tools:text="AMITKUMAR PARMESHWAR PRASAD" />
            </LinearLayout>

            <!-- Bank Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bank_name_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/bank_name"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_bank_name"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_9sdp"
                    tools:text="SBI" />
            </LinearLayout>

            <!-- Account Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_account_number_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/account_number"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_account_number"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_9sdp"
                    tools:text="30980430524" />
            </LinearLayout>

            <!-- IFSC Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ifsc_code_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/ifsc_code"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_ifsc_code"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_9sdp"
                    tools:text="SBIN0001754" />
            </LinearLayout>

            <!-- Remark -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_remark_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/remark"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_9sdp" />

                <TextView
                    android:id="@+id/tv_remark"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_9sdp"
                    tools:text="-" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
