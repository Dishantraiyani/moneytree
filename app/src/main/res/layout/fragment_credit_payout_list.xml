<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include android:id="@+id/layout_header"
        layout="@layout/layout_header"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cl_filter_change_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_5sdp"
        app:cardCornerRadius="@dimen/_6sdp"
        app:cardElevation="@dimen/_1sdp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@+id/layout_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_filter_payment_status"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:padding="@dimen/_1sdp"
            app:guidelineUseRtl="true"
            app:chainUseRtl="true"
            app:layout_constrainedWidth="true"
            android:background="@drawable/gray_border"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_header">

            <ImageView
                android:id="@+id/iv_status_filter"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                android:src="@drawable/ic_filter"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@string/username_title" />

            <Spinner
                android:id="@+id/payment_status_spinner"
                style="@style/LoginSubFontsZeroWrap"
                android:minHeight="@dimen/_38sdp"
                android:textSize="@dimen/_12sdp"
                android:gravity="center_vertical"
                android:background="@null"
                android:clickable="false"
                android:paddingHorizontal="@dimen/_10sdp"
                android:spinnerMode="dropdown"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_status_filter"
                app:layout_constraintEnd_toStartOf="@id/iv_drop_down"/>

            <ImageView
                android:id="@+id/iv_drop_down"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:src="@drawable/ic_spinner_drop_down"
                android:layout_marginEnd="@dimen/_10sdp"
                android:tint="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:contentDescription="@string/username_title"
                tools:ignore="UseAppTint" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>


    <!-- Credit Payout Summary Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_credit_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:cardCornerRadius="@dimen/_6sdp"
        app:cardElevation="@dimen/_2sdp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toBottomOf="@+id/cl_filter_change_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp">

            <!-- Total Request -->
            <LinearLayout
                android:id="@+id/ll_total_request"
                android:layout_width="0dp"
                android:layout_height="@dimen/_52sdp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/_4sdp"
                android:background="@drawable/bg_credit_payout"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_3sdp"
                android:paddingVertical="@dimen/_5sdp"
                app:layout_constraintEnd_toStartOf="@id/ll_total_amount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_total_request_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/total_withdrawal"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_total_withdraw"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textColor="#0FCE6E"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="3" />

                <TextView
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/before_tds"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_7sdp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Total Amount -->
            <LinearLayout
                android:id="@+id/ll_total_amount"
                android:layout_width="0dp"
                android:layout_height="@dimen/_52sdp"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:background="@drawable/bg_credit_payout"
                android:backgroundTint="#FDFAF6"
                android:orientation="vertical"
                android:gravity="start"
                android:paddingStart="@dimen/_5sdp"
                android:paddingEnd="@dimen/_3sdp"
                android:paddingVertical="@dimen/_5sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ll_total_request"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_total_tds"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/tds_title"
                    android:textAllCaps="true"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_tds"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textColor="#0FCE6E"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="₹1800.00" />

                <TextView
                    android:id="@+id/tv_net_payable"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/before_tds"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_7sdp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Pending Amount -->
            <LinearLayout
                android:id="@+id/ll_pending_amount"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:background="@drawable/bg_credit_payout"
                android:backgroundTint="#FEF7F0"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_total_amount"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_pending_amount_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/pending_withdrawal"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/tv_pending_amount"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textColor="#FFA500"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="₹1200.00"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <!-- Accepted Amount -->
            <LinearLayout
                android:id="@+id/ll_accepted_amount"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_credit_payout"
                android:backgroundTint="#F5FAF6"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_pending_amount"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_accepted_amount_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/accepted_withdrawal"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/tv_accepted_amount"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textColor="#0FCE6E"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="₹1200.00"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_rejected_amount"
                android:layout_width="0dp"
                android:layout_height="@dimen/_20sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_credit_payout"
                android:backgroundTint="#FFF5F5"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_accepted_amount"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_rejected_amount_title"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/rejected_withdrawal"
                    android:textColor="@color/gray_text"
                    android:textSize="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:gravity="start" />

                <TextView
                    android:id="@+id/tv_rejected_amount"
                    style="@style/LoginSubFontsWrap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:text="₹1200.00"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_not_found"
        style="@style/LayoutWidthHeightZero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_credit_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_not_found"
            style="@style/LayoutWidthHeightZero"
            android:paddingVertical="@dimen/_6sdp"
            android:clipToPadding="false"
            android:text="@string/no_item"
            android:textColor="@color/black"
            android:gravity="center|bottom"
            android:textSize="@dimen/_16sdp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_not_found_sub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_not_found_sub"
            style="@style/LayoutWidthHeightZero"
            android:clipToPadding="false"
            android:text="@string/no_credit_withdrawal_available"
            android:textColor="@color/gray_text"
            android:gravity="center|top"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_not_found"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_refresh"
        style="@style/LayoutWidthHeightZero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/card_credit_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="0dp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:clipToPadding="false"
            android:visibility="gone"/>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <RelativeLayout
        android:id="@+id/cv_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:visibility="gone"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_centerInParent="true" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
