<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	tools:context=".ui.profile.password.NSChangePasswordFragment">

	<include android:id="@+id/layout_header"
		layout="@layout/layout_header"/>

	<androidx.core.widget.NestedScrollView
		style="@style/LayoutWidthHeightZero"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintTop_toBottomOf="@id/layout_header"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingVertical="@dimen/_20sdp"
			android:paddingHorizontal="@dimen/_15sdp">

			<androidx.cardview.widget.CardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_2sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingTop="0dp"
					android:paddingBottom="@dimen/_10sdp">


					<TextView
						style="@style/LoginSubFontsWrap"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textColor="@color/white"
						android:textSize="@dimen/_10sdp"
						android:gravity="center"
						android:background="@drawable/half_top_corners_five"
						android:backgroundTint="@color/orange"
						android:paddingVertical="@dimen/_10sdp"
						android:fontFamily="@font/inter_semi_bold"
						android:text="@string/order_summary"/>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:paddingHorizontal="@dimen/_3sdp"
						android:layout_marginTop="@dimen/_15sdp">

						<TextView
							style="@style/LoginSubFontsWrap"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="wrap_content"
							android:layout_marginStart="@dimen/_5sdp"
							android:text="@string/products"
							android:textColor="@color/black"
							android:textSize="@dimen/_10sdp" />

						<TextView
							style="@style/LoginSubFontsWrap"
							android:layout_height="wrap_content"
							android:layout_marginEnd="@dimen/_5sdp"
							android:text="@string/amount_title"
							android:layout_gravity="end|center_vertical"
							android:textColor="@color/black"
							android:textSize="@dimen/_10sdp" />
					</LinearLayout>

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:paddingHorizontal="@dimen/_3sdp"
						android:layout_marginTop="@dimen/_5sdp">

						<TextView
							android:id="@+id/tv_product_title"
							style="@style/LoginSubFontsWrap"
							android:layout_width="0dp"
							android:layout_weight="1"
							android:layout_height="wrap_content"
							android:layout_marginStart="@dimen/_5sdp"
							android:textColor="@color/black"
							android:textSize="@dimen/_10sdp" />

						<TextView
							android:id="@+id/tv_amount"
							style="@style/LoginSubFontsWrap"
							android:layout_height="wrap_content"
							android:layout_marginEnd="@dimen/_5sdp"
							android:layout_gravity="end|center_vertical"
							android:textColor="@color/black"
							android:fontFamily="@font/inter_semi_bold"
							android:textSize="@dimen/_10sdp" />

					</LinearLayout>

				</LinearLayout>

			</androidx.cardview.widget.CardView>

			<RadioGroup
				android:id="@+id/rdoPaymentType"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_marginTop="@dimen/_15sdp">

				<RadioButton
					android:id="@+id/rb_wallet"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:checked="true"
					android:text="@string/wallet"
					android:fontFamily="@font/inter_regular"
					android:paddingHorizontal="@dimen/_2sdp"
					android:buttonTint="@color/orange"
					android:textSize="@dimen/_12sdp" />

				<RadioButton
					android:id="@+id/rbPaymentGateway"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="@dimen/_10sdp"
					android:text="@string/payment_gateway"
					android:fontFamily="@font/inter_regular"
					android:paddingHorizontal="@dimen/_2sdp"
					android:buttonTint="@color/orange"
					android:textSize="@dimen/_12sdp" />

			</RadioGroup>


			<TextView
				android:id="@+id/tv_wallet_title"
				style="@style/LoginSubFontsWrap"
				android:text="@string/available_wallet_amount"
				android:textColor="@color/black"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:textSize="@dimen/_10sdp"/>

			<androidx.cardview.widget.CardView
				android:id="@+id/card_wallet_amount"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				app:cardBackgroundColor="@color/gray_background"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_wallet_amount"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_wallet_amount"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/ic_wallet_coin"
						android:layout_marginStart="@dimen/_10sdp"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<TextView
						android:id="@+id/tv_wallet_amount"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:background="@drawable/phone_gray_background"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/amount_title"
						android:gravity="center_vertical"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_wallet_amount"
						app:layout_constraintEnd_toEndOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				android:id="@+id/tv_notes"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical"
				android:layout_marginTop="@dimen/_10sdp"
				android:text="@string/note_5_admin"
				android:textSize="@dimen/_10sdp"
				android:paddingStart="@dimen/_5sdp"
				android:textColorLink="@color/orange"
				android:paddingEnd="@dimen/_15sdp"
				android:lineSpacingExtra="@dimen/_2sdp"
				android:textColor="@color/black"
				android:fontFamily="@font/inter_regular"
				android:visibility="gone"/>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:text="@string/member_id_title_"
				android:textColor="@color/black"
				android:layout_marginTop="@dimen/_15sdp"
				android:layout_marginStart="@dimen/_5sdp"
				android:textSize="@dimen/_10sdp"/>

			<androidx.cardview.widget.CardView
				android:id="@+id/card_member_id"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				app:cardBackgroundColor="@color/background_gray"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_member_id"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_member_id"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/tab_profile"
						android:layout_marginStart="@dimen/_10sdp"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<TextView
						android:id="@+id/tv_member_id"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:lines="1"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/member_id_title_"
						android:gravity="center_vertical"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_member_id"
						app:layout_constraintEnd_toEndOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:text="@string/full_name"
				android:textColor="@color/black"
				android:textSize="@dimen/_10sdp" />

			<androidx.cardview.widget.CardView
				android:id="@+id/card_full_name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/card_wallet_amount">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_full_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_member_name"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/tab_profile"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_full_name"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:lines="1"
						android:background="@null"
						android:inputType="textPersonName"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/full_name"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_member_name"
						app:layout_constraintEnd_toEndOf="parent"
						android:gravity="center_vertical"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:text="@string/email"
				android:textColor="@color/black"
				android:textSize="@dimen/_10sdp" />

			<androidx.cardview.widget.CardView
				android:id="@+id/card_email"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/card_wallet_amount">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_email"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_email"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/tab_profile"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_email"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:lines="1"
						android:background="@null"
						android:inputType="textEmailAddress"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/email"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_email"
						app:layout_constraintEnd_toEndOf="parent"
						android:gravity="center_vertical"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:text="@string/mobile"
				android:textColor="@color/black"
				android:textSize="@dimen/_10sdp" />

			<androidx.cardview.widget.CardView
				android:id="@+id/card_mobile"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toBottomOf="@+id/card_wallet_amount">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_mobile"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_mobile"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/ic_phone"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_mobile"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:lines="1"
						android:background="@null"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/mobile"
						android:inputType="phone"
						android:digits="0123456789"
						android:maxLength="10"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_mobile"
						app:layout_constraintEnd_toEndOf="parent"
						android:gravity="center_vertical"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:text="@string/address"
				android:textColor="@color/black"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:textSize="@dimen/_10sdp"/>

			<androidx.cardview.widget.CardView
				android:id="@+id/card_recharge_type"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_recharge_type"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_recharge_type"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/ic_wallet_coin"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_address"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:lines="1"
						android:background="@null"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/address"
						android:inputType="textPostalAddress"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_recharge_type"
						app:layout_constraintEnd_toEndOf="parent"
						android:gravity="center_vertical"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:text="@string/pin_code"
				android:textColor="@color/black"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:textSize="@dimen/_10sdp"/>

			<androidx.cardview.widget.CardView
				android:id="@+id/card_pin_code"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_pin_code"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_pin_code"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/remark"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_pin_code"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:inputType="number"
						android:lines="1"
						android:background="@drawable/phone_white_background"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/pin_code"
						android:digits="0123456789"
						android:gravity="center_vertical"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_pin_code"
						app:layout_constraintEnd_toEndOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>

			<TextView
				style="@style/LoginSubFontsWrap"
				android:text="@string/town"
				android:textColor="@color/black"
				android:layout_marginStart="@dimen/_5sdp"
				android:layout_marginTop="@dimen/_15sdp"
				android:textSize="@dimen/_10sdp"/>

			<androidx.cardview.widget.CardView
				android:id="@+id/card_city"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_6sdp"
				app:cardCornerRadius="@dimen/_5sdp"
				android:layout_marginHorizontal="@dimen/_5sdp"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/cl_city"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/_1sdp"
					app:guidelineUseRtl="true"
					app:chainUseRtl="true">

					<ImageView
						android:id="@+id/iv_city"
						android:layout_width="@dimen/_15sdp"
						android:layout_height="@dimen/_15sdp"
						android:src="@drawable/remark"
						android:layout_marginStart="@dimen/_10sdp"
						android:visibility="gone"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						android:contentDescription="@string/username_title" />

					<EditText
						android:id="@+id/et_city"
						style="@style/LoginSubFontsZeroWrap"
						android:minHeight="@dimen/_38sdp"
						android:textColor="@color/black"
						android:inputType="text"
						android:lines="1"
						android:background="@drawable/phone_white_background"
						android:paddingHorizontal="@dimen/_10sdp"
						android:hint="@string/town"
						android:gravity="center_vertical"
						android:textColorHint="@color/hint_color"
						app:layout_constraintTop_toTopOf="parent"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/iv_city"
						app:layout_constraintEnd_toEndOf="parent" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</androidx.cardview.widget.CardView>


			<TextView
