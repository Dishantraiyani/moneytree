<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_10sdp"
    android:paddingVertical="@dimen/_5sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_voucher_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Header Area with soft green background -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_voucher_header"
            android:padding="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Vertical Divider in Header -->
            <View
                android:id="@+id/v_header_divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:background="@color/card_divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Left: Claim Status -->
            <TextView
                android:id="@+id/tv_claim_status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/claim_status_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_claim_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_activated"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:textColor="@color/status_activated_text"
                android:textSize="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_4sdp"
                tools:text="Accepted"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_claim_status_title" />

            <!-- Right: Voucher Amount -->
            <TextView
                android:id="@+id/tv_voucher_amount_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/voucher_amount_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_voucher_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/downline_total_text"
                android:textSize="@dimen/_13sdp"
                android:layout_marginTop="@dimen/_2sdp"
                tools:text="₹3,000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_voucher_amount_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Main Body Details Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_body_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_header_section">

            <!-- Vertical Divider for all rows in body -->
            <View
                android:id="@+id/v_vertical_divider"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:background="@color/card_divider"
                android:layout_marginHorizontal="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_entry_date_title"
                app:layout_constraintBottom_toBottomOf="@id/tv_repurchase_done" />

            <!-- Row 1: Entry Date & Expiry Date -->
            <TextView
                android:id="@+id/tv_entry_date_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/entry_date_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_entry_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/dark_black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                tools:text="25-08-2026"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
                app:layout_constraintTop_toBottomOf="@id/tv_entry_date_title" />

            <TextView
                android:id="@+id/tv_expiry_date_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/expiry_date_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_expiry_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/dark_black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_8sdp"
                tools:text="25-02-2027"
                app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_expiry_date_title" />

            <!-- Row 2: Target Repurchase & Repurchase Done -->
            <View
                android:id="@+id/v_divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_divider"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_entry_date" />

            <TextView
                android:id="@+id/tv_target_repurchase_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/target_repurchase_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
                app:layout_constraintTop_toBottomOf="@id/v_divider1" />

            <TextView
                android:id="@+id/tv_target_repurchase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/dark_black"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                tools:text="₹30,000"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/v_vertical_divider"
                app:layout_constraintTop_toBottomOf="@id/tv_target_repurchase_title" />

            <TextView
                android:id="@+id/tv_repurchase_done_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/repurchase_done_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_8sdp"
                app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_divider1" />

            <TextView
                android:id="@+id/tv_repurchase_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/downline_total_text"
                android:textSize="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginStart="@dimen/_8sdp"
                tools:text="₹252,246"
                app:layout_constraintStart_toEndOf="@id/v_vertical_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_repurchase_done_title" />

            <!-- Row 3: Claim Remark Section -->
            <View
                android:id="@+id/v_divider2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/card_divider"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_target_repurchase" />

            <TextView
                android:id="@+id/tv_claim_remark_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:text="@string/claim_remark_title"
                android:textColor="@color/gray_text"
                android:textSize="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v_divider2" />

            <TextView
                android:id="@+id/tv_claim_remark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remark_box"
                android:fontFamily="@font/inter_medium"
                android:padding="@dimen/_8sdp"
                android:textColor="@color/dark_black"
                android:textSize="@dimen/_9sdp"
                android:layout_marginTop="@dimen/_4sdp"
                tools:text="02 Hair 2X Kit Issued with H Kumar Herbal\nInvoice No.OWPL063 (08-Sep-26)"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_claim_remark_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
